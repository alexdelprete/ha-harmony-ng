{
  "entity": {
    "binary_sensor": {
      "busy": {
        "default": "mdi:progress-clock",
        "state": {
          "off": "mdi:check-circle-outline"
        }
      },
      "charging": {
        "default": "mdi:battery-charging"
      },
      "config_out_of_sync": {
        "default": "mdi:sync",
        "state": {
          "on": "mdi:sync-alert"
        }
      },
      "bt_host": {
        "default": "mdi:bluetooth"
      }
    },
    "button": {
      "power_off": {
        "default": "mdi:power"
      },
      "sync_remotes": {
        "default": "mdi:sync"
      },
      "cancel_activity": {
        "default": "mdi:cancel"
      },
      "wake": {
        "default": "mdi:cellphone-arrow-down"
      },
      "sleep": {
        "default": "mdi:sleep"
      },
      "start_activity": {
        "default": "mdi:play-circle-outline"
      },
      "device_command": {
        "default": "mdi:remote"
      }
    },
    "event": {
      "button": {
        "default": "mdi:remote"
      }
    },
    "infrared": {
      "ir_front": {
        "default": "mdi:remote-tv"
      },
      "ir_jack1": {
        "default": "mdi:led-on"
      },
      "ir_jack2": {
        "default": "mdi:led-on"
      },
      "ir_receiver": {
        "default": "mdi:remote-tv"
      }
    },
    "select": {
      "activity": {
        "default": "mdi:television-play"
      }
    },
    "sensor": {
      "activity_state": {
        "default": "mdi:television",
        "state": {
          "idle": "mdi:television-off",
          "starting": "mdi:television-play",
          "running": "mdi:television",
          "stopping": "mdi:television-off"
        }
      },
      "firmware": {
        "default": "mdi:chip"
      },
      "uptime": {
        "default": "mdi:clock-start"
      },
      "battery": {
        "default": "mdi:battery"
      },
      "battery_voltage": {
        "default": "mdi:flash"
      }
    },
    "update": {
      "firmware_update": {
        "default": "mdi:update"
      }
    }
  },
  "services": {
    "ir_send": {
      "service": "mdi:remote"
    },
    "bt_key": {
      "service": "mdi:keyboard"
    },
    "activity_help": {
      "service": "mdi:help-circle"
    },
    "activity_help_answer": {
      "service": "mdi:help-circle-outline"
    },
    "activity_cancel": {
      "service": "mdi:cancel"
    },
    "sync": {
      "service": "mdi:sync"
    }
  }
}
